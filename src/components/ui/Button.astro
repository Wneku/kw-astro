---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { variant?: 'primary' | 'outline' | 'light'; size?: 'm' | 'l' };
const { variant = 'primary', size = 'm', class: className, ...rest } = Astro.props;
---

<a class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    border-radius: 999px;
    border: 2px solid transparent;
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      color 0.15s,
      border-color 0.15s,
      transform 0.15s,
      box-shadow 0.15s;
  }
  .btn--m {
    padding: 0.7em 1.4em;
    font-size: 0.9375rem;
  }
  .btn--l {
    padding: 0.95em 1.9em;
    font-size: var(--step-0);
  }
  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 8px 20px -8px rgb(40 114 250 / 0.6);
  }
  .btn--primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
  }
  .btn--outline {
    border-color: var(--color-border);
    color: var(--color-heading);
  }
  .btn--outline:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .btn--light {
    background: var(--color-on-dark);
    color: var(--color-heading);
  }
  .btn--light:hover {
    color: var(--color-primary);
  }
</style>
