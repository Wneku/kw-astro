---

<ul class:list={['socials', `socials--${variant}`]}>
  {
    SOCIALS.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="me noopener" aria-label={s.label} title={s.label}>
          <svg width="18" height="18" viewBox={PATHS[s.icon].viewBox} aria-hidden="true" fill="currentColor">
            <path d={PATHS[s.icon].d} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }
  /* reset stylów list z .prose (li + li { margin-top }) – ikony w jednej linii */
  .socials li {
    margin: 0;
  }
  a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .socials--light a {
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .socials--dark a {
    background: rgb(218 222 228 / 0.15);
    color: var(--color-on-dark);
  }
  a:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
</style>
