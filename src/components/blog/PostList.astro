---
import PostCard from './PostCard.astro';
import type { Post } from '../../lib/blog';

export interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel = 'h2' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">Wkrótce pojawią się tu pierwsze wpisy.</p>
  ) : (
    <ul class="posts">
      {posts.map((post, i) => (
        <li>
          <PostCard post={post} headingLevel={headingLevel} eager={i < 3} />
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  @media (max-width: 1024px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
  .empty {
    color: var(--color-muted);
  }
</style>
