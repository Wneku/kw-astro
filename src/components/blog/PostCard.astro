---
import { Image } from 'astro:assets';
import { getEntries } from 'astro:content';
import { formatDate, postHref, categoryHref, type Post } from '../../lib/blog';

export interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { post, headingLevel: H = 'h3', eager = false } = Astro.props;
const categories = await getEntries(post.data.categories);
---

<article class="card">
  <a href={postHref(post.id)} class="card__media" tabindex="-1" aria-hidden="true">
    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt}
          widths={[400, 640, 800]}
          sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px"
          loading={eager ? 'eager' : 'lazy'}
        />
      )
    }
  </a>
  <div class="card__body">
    <ul class="card__cats">
      {
        categories.map((c) => (
          <li>
            <a href={categoryHref(c.id)}>{c.data.name}</a>
          </li>
        ))
      }
    </ul>
    <H class="card__title">
      <a href={postHref(post.id)}>{post.data.title}</a>
    </H>
    <p class="card__excerpt">{post.data.description}</p>
    <div class="card__foot">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a href={postHref(post.id)} class="card__more" aria-label={`Czytaj więcej: ${post.data.title}`}>
        Czytaj więcej <span class="card__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: var(--shadow-s);
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  .card__media {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
    overflow: hidden;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }
  .card:hover .card__media :global(img) {
    transform: scale(1.03);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    flex: 1;
    padding: var(--space-l);
  }
  .card__cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    list-style: none;
    padding: 0;
    font-family: var(--font-heading);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .card__cats a {
    text-decoration: none;
  }
  .card__title {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }
  .card__title a {
    color: inherit;
    text-decoration: none;
  }
  .card__title a:hover {
    color: var(--color-primary);
  }
  .card__excerpt {
    font-size: var(--step--1);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: auto;
    padding-top: var(--space-xs);
  }
  time {
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  .card__more {
    font-family: var(--font-heading);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .card__arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }
  .card:hover .card__arrow {
    transform: translateX(3px);
  }

  /* cała karta klikalna: link z tytułu rozciągnięty na kartę; kategorie nad nim, więc działają osobno */
  .card {
    position: relative;
  }
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card__cats a,
  .card__more {
    position: relative;
    z-index: 2;
  }
  .card:hover .card__title a {
    color: var(--color-primary);
  }
  .card:has(.card__title a:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .card__title a:focus-visible {
    outline: none;
  }
</style>
