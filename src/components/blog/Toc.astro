---
/**
 * Spis treści generowany z nagłówków H2/H3 wpisu.
 *  - desktop (≥1100px): przyklejony w bocznej kolumnie, podświetla bieżącą sekcję,
 *  - mobile/tablet: nad treścią, widać pierwsze 3 pozycje + „Pokaż cały spis”.
 * Bez JS spis jest po prostu pełną listą linków.
 */
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
  /** ile pozycji widać na mobile przed rozwinięciem */
  visible?: number;
}
const { headings, visible = 3 } = Astro.props;
const items = headings.filter((h) => (h.depth === 2 || h.depth === 3) && !/^spis treści$/i.test(h.text.trim()));
const hidden = Math.max(0, items.length - visible);
---

{
  items.length >= 3 && (
    <nav class="toc" aria-labelledby="toc-title" data-toc>
      <p class="toc__title" id="toc-title">
        Spis treści
      </p>
      <ol class="toc__list">
        {items.map((h, i) => (
          <li class:list={['toc__item', `toc__item--h${h.depth}`]} data-extra={i >= visible ? '' : undefined}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
      {hidden > 0 && (
        <button class="toc__more" type="button" aria-expanded="false" data-toc-more hidden>
          <span data-label-closed>Pokaż cały spis ({items.length})</span>
          <span data-label-open hidden>
            Zwiń spis
          </span>
        </button>
      )}
    </nav>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
    // Zwijanie (działa tylko na mobile – na desktopie CSS pokazuje całość)
    const more = toc.querySelector<HTMLButtonElement>('[data-toc-more]');
    if (more) {
      toc.dataset.collapsible = 'true';
      more.hidden = false;
      more.addEventListener('click', () => {
        const open = !toc.hasAttribute('data-open');
        toc.toggleAttribute('data-open', open);
        more.setAttribute('aria-expanded', String(open));
        more.querySelector<HTMLElement>('[data-label-closed]')!.hidden = open;
        more.querySelector<HTMLElement>('[data-label-open]')!.hidden = !open;
      });
    }

    // Podświetlanie bieżącej sekcji (scroll-spy)
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]),
    );
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));
    if (!targets.length) return;

    const setActive = (id: string) => {
      links.forEach((a, key) => {
        const active = key === id;
        a.classList.toggle('is-active', active);
        if (active) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
      // na desktopie przewiń listę spisu tak, by aktywna pozycja była widoczna
      const active = links.get(id);
      const list = toc.querySelector<HTMLElement>('.toc__list');
      if (active && list && list.scrollHeight > list.clientHeight) {
        const top = active.offsetTop - list.offsetTop;
        if (top < list.scrollTop || top > list.scrollTop + list.clientHeight - 40) {
          list.scrollTo({ top: top - list.clientHeight / 3, behavior: 'smooth' });
        }
      }
    };

    // aktywna = ostatni nagłówek, który minął górną część ekranu
    const update = () => {
      const line = window.innerHeight * 0.25;
      let current = targets[0].id;
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= line) current = el.id;
        else break;
      }
      setActive(current);
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    update();
  });
</script>

<style>
  .toc {
    padding: var(--space-l);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    font-size: var(--step--1);
  }
  .toc__title {
    font-family: var(--font-heading);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-s);
  }
  .toc__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .toc__item a {
    display: block;
    padding: 0.35em 0.6em;
    border-left: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    color: var(--color-text);
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s,
      border-color 0.15s;
  }
  .toc__item--h3 a {
    padding-left: 1.6em;
    font-size: 0.95em;
    color: var(--color-muted);
  }
  .toc__item a:hover {
    color: var(--color-primary);
  }
  .toc__item a.is-active {
    border-left-color: var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-heading);
    font-weight: 600;
  }
  .toc__more {
    margin-top: var(--space-s);
    padding: 0.5em 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 700;
    cursor: pointer;
  }
  .toc__more:hover {
    text-decoration: underline;
  }

  /* Mobile/tablet: zwinięty do kilku pozycji */
  @media (max-width: 1099px) {
    .toc[data-collapsible='true']:not([data-open]) [data-extra] {
      display: none;
    }
  }
  /* Desktop: boczna kolumna – całość, przewijana, bez przycisku */
  @media (min-width: 1100px) {
    .toc {
      padding: var(--space-m) var(--space-m) var(--space-m) var(--space-s);
      background: transparent;
      border: 0;
      border-left: 1px solid var(--color-border);
      border-radius: 0;
    }
    .toc__title {
      padding-left: 0.6em;
    }
    .toc__list {
      max-height: calc(100vh - var(--header-h) - 10rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
    .toc__more {
      display: none;
    }
  }
</style>
