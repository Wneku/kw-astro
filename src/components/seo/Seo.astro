---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../../config/site';
import { buildGraph, type Crumb, type FaqItem } from '../../lib/schema';
import defaultOg from '../../assets/images/wp/2025/12/IMG_3829.jpg';

export interface SeoProps {
  /** Pełny <title> (np. z Rank Math). Bez niego: SITE.title */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: Crumb[];
  faq?: FaqItem[];
  datePublished?: Date;
  dateModified?: Date;
  article?: { headline: string; section?: string };
}
type Props = SeoProps;

const {
  title = SITE.title,
  description = SITE.description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  crumbs,
  faq,
  datePublished,
  dateModified,
  article,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: image ?? defaultOg, width: 1200, format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;

const robots = noindex
  ? 'noindex, follow'
  : 'follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large';

// Schema: tylko BreadcrumbList i FAQPage (null, gdy strona nie ma żadnego z nich)
const jsonLd = buildGraph({ url: Astro.url.pathname, crumbs, faq });
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
<meta property="og:image:height" content={String(og.attributes.height ?? '')} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{
  type === 'article' && datePublished && (
    <meta property="article:published_time" content={datePublished.toISOString()} />
  )
}
{type === 'article' && dateModified && <meta property="article:modified_time" content={dateModified.toISOString()} />}
{article?.section && <meta property="article:section" content={article.section} />}
<meta name="twitter:card" content="summary_large_image" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
