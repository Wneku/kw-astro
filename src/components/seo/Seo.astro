---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../../config/site';
import { buildGraph, blogPostingNode, type Crumb, type FaqItem, type PageSchema } from '../../lib/schema';
import defaultOg from '../../assets/images/wp/2025/12/IMG_3829.jpg';

export interface SeoProps {
  /** Pełny <title> (np. z Rank Math). Bez niego: SITE.title */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: Crumb[];
  faq?: FaqItem[];
  datePublished?: Date;
  dateModified?: Date;
  /** Wpis blogowy → meta article:* + węzeł BlogPosting w schemie */
  article?: { headline: string; sections: string[]; wordCount: number; minutes: number };
  /** Opis schemy strony (typ, about, mainEntity, dodatkowe węzły) – patrz src/lib/schema.ts */
  schema?: PageSchema;
  /** false = brak JSON-LD (404, strona z podziękowaniem) */
  structuredData?: boolean;
}
type Props = SeoProps;

const {
  title = SITE.title,
  description = SITE.description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  crumbs,
  faq,
  datePublished,
  dateModified,
  article,
  schema = {},
  structuredData = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: image ?? defaultOg, width: 1200, format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;

const robots = noindex
  ? 'noindex, follow'
  : 'follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large';

// Schema (docs/schema-propozycja.md): globalne Person/Organization/WebSite + węzły strony
const path = Astro.url.pathname;
const articleNodes = article
  ? [
      blogPostingNode({
        path,
        headline: article.headline,
        description,
        image: image ? { url: og.src, width: og.attributes.width as number, height: og.attributes.height as number } : undefined,
        datePublished: datePublished!,
        dateModified,
        sections: article.sections,
        wordCount: article.wordCount,
        minutes: article.minutes,
      }),
    ]
  : [];
const jsonLd = structuredData
  ? buildGraph({
      url: path,
      title,
      description,
      crumbs,
      faq,
      datePublished,
      dateModified,
      page: { ...schema, nodes: [...(schema.nodes ?? []), ...articleNodes] },
    })
  : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
<meta property="og:image:height" content={String(og.attributes.height ?? '')} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{
  type === 'article' && datePublished && (
    <meta property="article:published_time" content={datePublished.toISOString()} />
  )
}
{type === 'article' && dateModified && <meta property="article:modified_time" content={dateModified.toISOString()} />}
{article?.sections[0] && <meta property="article:section" content={article.sections[0]} />}
<meta name="twitter:card" content="summary_large_image" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
