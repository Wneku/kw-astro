---
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Faq from '../../components/ui/Faq.astro';
import WhyMe from '../../components/sections/WhyMe.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import { SERVICE_GROUPS } from '../../config/services';
import { serviceHref } from '../../lib/navigation';

export async function getStaticPaths() {
  const services = await getCollection('oferta', ({ data }) => !data.draft);
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const intro = data.intro ? await marked.parse(data.intro) : '';
const group = SERVICE_GROUPS.find((g) => g.id === data.group);

const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Oferta', href: '/oferta/' },
  { name: data.title, href: serviceHref(service.id) },
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | Kamil Wnęk`}
  description={data.description}
  type="article"
  crumbs={crumbs}
  faq={data.faq}
  datePublished={data.pubDate}
  dateModified={data.updatedDate}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <Breadcrumbs crumbs={crumbs} />
        {group && <p class="eyebrow">{group.label}</p>}
        <h1>{data.title}</h1>
        <div class="hero__intro" set:html={intro} />
      </div>
      <ContactForm source={data.title} title="Zapytaj o wycenę" />
    </div>
  </section>

  <div class="container body">
    <article class="prose">
      <Content />
    </article>

    {data.whyMe && <WhyMe />}

    <Faq title={data.faqTitle} items={data.faq} />
  </div>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
    padding-block: var(--space-xl) var(--space-3xl);
  }
  .hero__text {
    display: grid;
    gap: var(--space-m);
  }
  .hero__text .eyebrow {
    margin-top: var(--space-l);
  }
  .hero__intro {
    display: grid;
    gap: var(--space-m);
    font-size: var(--step-0);
  }
  .hero__intro :global(p:first-child) {
    font-size: var(--step-1);
    color: var(--color-heading);
  }
  .hero__intro :global(ul) {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .hero__intro :global(li) {
    display: flex;
    gap: var(--space-xs);
    font-weight: 600;
    color: var(--color-heading);
  }
  .hero__intro :global(li)::before {
    content: '✓';
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 12px;
    font-weight: 800;
  }
  .body {
    display: grid;
    gap: var(--space-3xl);
  }
  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
