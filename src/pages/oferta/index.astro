---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import { SERVICE_GROUPS } from '../../config/services';
import { serviceHref } from '../../lib/navigation';
import pageSeo from '../../data/page-seo.json';
import { ID, ref, offerCatalogNode } from '../../lib/schema';

const services = (await getCollection('oferta', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const groups = SERVICE_GROUPS.map((g) => ({ ...g, services: services.filter((s) => s.data.group === g.id) })).filter(
  (g) => g.services.length,
);
const seo = pageSeo['/oferta/'];
const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Oferta', href: '/oferta/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  crumbs={crumbs}
  schema={{
    type: 'CollectionPage',
    mainEntity: ref(ID.on('/oferta/', 'catalog')),
    nodes: [
      offerCatalogNode(
        '/oferta/',
        groups.map((g) => ({ name: g.label, servicePaths: g.services.map((s) => serviceHref(s.id)) })),
      ),
    ],
  }}
>
  <header class="container page-head">
    <Breadcrumbs crumbs={crumbs} />
    <h1>Co mogę dla Ciebie zrobić?</h1>
  </header>

  <div class="container groups">
    {
      groups.map((g) => (
        <section class="group" aria-labelledby={`g-${g.id}`}>
          <div class="group__head">
            <span class="group__icon">
              <Icon name={g.icon} size={22} />
            </span>
            <div>
              <p class="eyebrow" id={`g-${g.id}`}>
                {g.label}
              </p>
              <p class="group__desc">{g.description}</p>
            </div>
          </div>
          <ul class="grid">
            {g.services.map((s) => (
              <li class="card">
                <span class="card__icon">
                  <Icon name={s.data.icon ?? g.icon} size={22} />
                </span>
                <h2>{s.data.title}</h2>
                <p>{s.data.cardDescription ?? s.data.description}</p>
                <a href={serviceHref(s.id)} class="card__link">
                  Przeczytaj więcej <Icon name="arrow-right" size={16} strokeWidth={2.2} />
                  <span class="visually-hidden">: {s.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="container section">
    <div class="help">
      <div>
        <h2>Nie wiesz, którą usługę wybrać?</h2>
        <p>Opowiedz mi o swojej stronie – na bezpłatnej rozmowie wskażę, od czego warto zacząć.</p>
      </div>
      <Button href="/kontakt/#kalendarz" size="l">Umów bezpłatną rozmowę</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: var(--space-3xl);
  }
  .group__head {
    display: flex;
    gap: var(--space-m);
    align-items: center;
    margin-bottom: var(--space-l);
  }
  .group__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .group__desc {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-l);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    box-shadow: var(--shadow-s);
    transition:
      box-shadow 0.2s,
      transform 0.2s,
      border-color 0.2s;
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    border-color: rgb(40 114 250 / 0.35);
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .card h2 {
    font-size: var(--step-2);
  }
  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: auto;
    padding-top: var(--space-s);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
  }
  /* cała karta klikalna */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: var(--radius-l);
    background: var(--color-heading);
    background-image: radial-gradient(120% 120% at 100% 0%, rgb(40 114 250 / 0.55), transparent 60%);
    color: var(--color-on-dark-muted);
  }
  .help h2 {
    color: var(--color-on-dark);
    font-size: var(--step-3);
    margin-bottom: var(--space-xs);
  }
</style>
