---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import PostList from '../components/blog/PostList.astro';
import SplitContent from '../components/ui/SplitContent.astro';
import { getPosts } from '../lib/blog';
import { ID, ref } from '../lib/schema';

const page = (await getEntry('strony', 'o-mnie'))!;
const { Content } = await render(page);
const posts = (await getPosts()).slice(0, 3);
const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'O mnie', href: '/o-mnie/' },
];
---

<BaseLayout
  title={page.data.seoTitle}
  description={page.data.description}
  crumbs={crumbs}
  datePublished={page.data.pubDate}
  dateModified={page.data.updatedDate}
  schema={{ type: 'ProfilePage', mainEntity: ref(ID.person) }}
>
  <header class="container container--narrow page-head">
    <Breadcrumbs crumbs={crumbs} />
    {page.data.eyebrow && <p class="eyebrow">{page.data.eyebrow}</p>}
    <h1>{page.data.title}</h1>
  </header>

  <article class="container about-page">
    {/* social media i 3 ostatnie wpisy na końcu sekcji „Dzielę się wiedzą” (jak w WordPressie) */}
    <SplitContent afterHeading="dziele-sie-wiedza" class="prose about">
      <Content />
      <div slot="insert" class="share">
        <div class="share__socials"><SocialLinks /></div>
        <PostList posts={posts} headingLevel="h3" />
      </div>
    </SplitContent>
  </article>
</BaseLayout>

<style>
  /* tekst w wąskiej kolumnie na środku, karty wpisów na pełną szerokość */
  .about-page :global(.about) {
    max-width: 860px;
    margin-inline: auto;
  }
  /* Zdjęcie z pierwszego akapitu obok wstępu (jak kolumny w WordPressie) */
  .about-page :global(.about:first-child > p:first-child) {
    float: right;
    width: min(46%, 420px);
    margin: 0 0 var(--space-l) var(--space-xl);
  }
  .about-page :global(.about:first-child > p:first-child img) {
    width: 100%;
    border-radius: var(--radius-l);
    border: 0;
  }
  .about-page :global(.about:first-child > h2:nth-of-type(1)) {
    margin-top: 0;
  }
  .about-page :global(.about > h2:nth-of-type(2)) {
    clear: both;
  }
  .share__socials {
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
  }
  .share {
    display: grid;
    gap: var(--space-xl);
    margin-block: var(--space-l) var(--space-2xl);
  }
  @media (max-width: 760px) {
    .about-page :global(.about:first-child > p:first-child) {
      float: none;
      width: 100%;
      margin: 0 0 var(--space-l);
    }
  }
</style>
