---
/** /blog/page/2/, /blog/page/3/ … (strona 1 to /blog/) */
import BlogListing from '../../../components/blog/BlogListing.astro';
import { getPosts } from '../../../lib/blog';
import { paginate } from '../../../lib/pagination';
import { blogListingProps } from '../../../lib/listing';

export async function getStaticPaths() {
  return paginate(await getPosts(), '/blog/')
    .slice(1)
    .map((page) => ({ params: { page: String(page.current) }, props: { page } }));
}

const { page } = Astro.props;
---

<BlogListing page={page} {...blogListingProps} />
