---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { formatDate } from '../lib/blog';

const page = (await getEntry('strony', 'polityka-prywatnosci'))!;
const { Content } = await render(page);
const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: page.data.title, href: '/polityka-prywatnosci/' },
];
---

<BaseLayout
  title={page.data.seoTitle}
  description={page.data.description}
  noindex={page.data.noindex}
  crumbs={crumbs}
  dateModified={page.data.updatedDate}
>
  <header class="container container--narrow page-head">
    <Breadcrumbs crumbs={crumbs} />
    <h1>{page.data.title}</h1>
    {page.data.updatedDate && <p class="updated">Ostatnia aktualizacja: {formatDate(page.data.updatedDate)}</p>}
  </header>
  <div class="container container--narrow">
    <article class="prose">
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .updated {
    margin-top: var(--space-s);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
